# =====================================================================
# Produção — o meu jardim. Copie para deploy/.env e preencha.
# NUNCA versione o deploy/.env com valores reais.
# Este mesmo arquivo alimenta o docker compose (domínios) E a API (env_file).
# =====================================================================

# ---- Domínios (aponte o DNS de cada um para o IP deste servidor) ----
DOMINIO=omeujardim.app.br
API_DOMINIO=api.omeujardim.app.br
PAINEL_DOMINIO=painel.omeujardim.app.br
# E-mail para o Let's Encrypt avisar sobre os certificados.
ACME_EMAIL=voce@exemplo.com

# ---- API ----
NODE_ENV=production
PORT=3000

# Banco: por padrão, o Postgres deste compose (serviço "banco").
# Para usar um Postgres gerenciado externo, troque a URL e ponha DB_SSL=true.
POSTGRES_DB=meujardim
POSTGRES_USER=jardim
POSTGRES_PASSWORD=TROQUE_por_uma_senha_forte
DATABASE_URL=postgres://jardim:TROQUE_por_uma_senha_forte@banco:5432/meujardim
DB_SSL=false

# Redis interno do compose (serviço "cache").
REDIS_URL=redis://cache:6379

# Origens permitidas no CORS: o app e o painel, em https. Sem espaços.
CORS_ORIGENS=https://omeujardim.app.br,https://painel.omeujardim.app.br

# Segredos — gere NOVOS para produção (não reaproveite os de desenvolvimento):
#   openssl rand -base64 32
JWT_SEGREDO=GERE_UM_NOVO
JWT_EXPIRA=15m
REFRESH_EXPIRA_DIAS=30
# Cifra o diário (AES-256-GCM). Perder = perder o diário de todos. Faça backup
# desta chave separado do backup do banco.
CRIPTO_CHAVE=GERE_UM_NOVO
CRIPTO_CHAVE_ANTERIOR=

# Web Push (VAPID). Gere com: cd api && npm run vapid
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_CONTATO=mailto:jardim@omeujardim.app.br
LEMBRETES_INLINE=true

# Limites em produção (força bruta): login baixo, refresh ~60/h.
LOGIN_RATE_MAX=10
REFRESH_RATE_MAX=60

# ---- Efí (pagamentos) ----
# Comece em sandbox; vire para false só com as credenciais de produção.
EFI_SANDBOX=true
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
# Caminho do certificado .p12, relativo a api/. O compose monta ../api/certs em /app/certs.
EFI_CERTIFICADO=./certs/seu-certificado.p12
EFI_WEBHOOK_SEGREDO=TROQUE
EFI_PLANO_NOME=O meu jardim
EFI_PLANO_VALOR_CENTAVOS=1990
EFI_PLANO_CICLO=mensal
EFI_TRIAL_DIAS=7
EFI_PLANO_ID=
EFI_PIX_CHAVE=
# URL pública do webhook (cadastre no painel da Efí), com ?segredo= igual ao acima.
EFI_WEBHOOK_URL=https://api.omeujardim.app.br/v1/webhooks/efi?segredo=TROQUE

# ---- Build do app web (embutido no bundle no build) ----
# Código público da conta Efí (pode ficar no cliente).
EFI_PAYEE_CODE=
# 'false' em produção; 'true' só para testar no sandbox.
EFI_SANDBOX_WEB=false
