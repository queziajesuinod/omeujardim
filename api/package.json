{
  "name": "jardim-api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/servidor.js",
    "start": "node src/servidor.js",
    "migrar": "sequelize-cli db:migrate",
    "migrar:desfazer": "sequelize-cli db:migrate:undo",
    "migrar:status": "sequelize-cli db:migrate:status",
    "migracao:nova": "sequelize-cli migration:generate --name",
    "semear": "sequelize-cli db:seed:all",
    "semear:desfazer": "sequelize-cli db:seed:undo:all",
    "expurgar": "node src/tarefas/expurgar.js",
    "fechar-assinaturas": "node src/tarefas/fechar-assinaturas.js",
    "conferir-pix": "node src/tarefas/conferir-pix.js",
    "trilhas": "node src/tarefas/importar-trilhas.js",
    "vapid": "node src/tarefas/gerar-vapid.js",
    "lembretes": "node src/tarefas/enviar-lembretes.js",
    "papel": "node src/tarefas/conceder-papel.js",
    "teste": "node --test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/sensible": "^6.0.0",
    "@xenova/transformers": "^2.17.2",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "sdk-node-apis-efi": "^1.4.0",
    "sequelize": "^6.37.5",
    "uuid": "^11.0.3",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.2"
  }
}
